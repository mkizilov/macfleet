# Ceilings for scripts/performance-check.sh. Each one sits well above the numbers in README.md, so only a real regression
# fails it. A budget is changed in the same commit as the measurement that justifies it.
#
# Dashboard work for one sample on the main actor, median, in microseconds.
DASHBOARD_MEDIAN_US_MAX=2000
# History: mean cost of one save() call, in microseconds.
HISTORY_SAVE_MEAN_US_MAX=20
# History: median of 20 week-chart queries, in milliseconds.
HISTORY_WEEK_SERIES_MEDIAN_MS_MAX=5
# Fleet: median of 60 seven-day summaries for one Mac, in milliseconds.
FLEET_SUMMARY_MEDIAN_MS_MAX=5
# Fleet: average cost of one ingest call across three Macs, in microseconds.
FLEET_INGEST_US_PER_CALL_MAX=50
# Memory: resident memory added by writing seven days of history, in megabytes.
HISTORY_RSS_GROWTH_MB_MAX=64
# Reopen of a seven-day history file with its integrity check and upkeep, in milliseconds.
HISTORY_REOPEN_MS_MAX=200
